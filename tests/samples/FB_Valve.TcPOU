sbDone : BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[if R then
sTimer(IN:=TRUE,PT:=T#5S,Q=>sbDone);
end_if]]></ST>
    </Implementation>
    <Method Name="M_Reset" Id="{aaaaaaaa-2222-3333-4444-555555555555}">
      <Declaration><![CDATA[METHOD M_Reset : BOOL
VAR_INPUT
bForce:BOOL;
END_VAR
VAR
x : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[x:=0;
M_Reset:=TRUE;]]></ST>
      </Implementation>
    </Method>
    <LineIds Name="FB_Valve">
